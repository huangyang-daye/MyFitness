# PostgreSQL
# Windows 建议用 127.0.0.1 而非 localhost（避免 IPv6 连接等待 2min+）
DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/myfitness
# DB_CONNECT_TIMEOUT=5

# 训记鉴权（可选 — 默认从 skills/xunji-*/SKILL.md 内嵌 Token 读取）
# 若 Skill 已更新，也可在此覆盖；勿提交到 Git
# XUNJI_BODY_API_KEY=
# XUNJI_FOOD_API_KEY=
# XUNJI_FOOD_SEARCH_KEY=
# XUNJI_TRAINING_API_KEY=

# LLM — OpenAI 兼容通用接口（DeepSeek、OpenAI、Ollama 代理等）
# 填写 BASE_URL + API_KEY + MODEL 即可激活
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# LLM 限制与兜底：重试/退避为内置常量；以下守卫参数可按需调整
# 守卫内置默认：最小间隔 1s，连续失败 3 次熔断 60s（详见 src/myfitness/llm/guard.py）

# 兼容旧变量（LLM_API_KEY 优先）
# OPENAI_API_KEY=

# 使用记录目录 — 与项目本体分离
# 报告、图表、对话历史等运行时产物一律写在 DATA_DIR 之下，不污染项目目录。
# 留空则回落到平台默认：Windows %LOCALAPPDATA%\MyFitness，
# macOS ~/Library/Application Support/MyFitness，Linux ~/.local/share/MyFitness。
DATA_DIR=D:/MyFitness-data

# 调度（M3+ 使用）
DAILY_REPORT_TIME=07:00
DAILY_REPORT_MODE=full
# 以下三项留空即分别回落到 <DATA_DIR>/reports、<DATA_DIR>/reports/charts、
# <DATA_DIR>/chat-history；需要分盘存放时再单独覆盖。
# DAILY_REPORT_OUTPUT_DIR=
# 统计图（mermaid）独立文档输出目录
# CHART_OUTPUT_DIR=
# 对话记录目录
# CHAT_HISTORY_DIR=

# 应用
LOG_LEVEL=INFO
DEBUG_MODE=false
DEFAULT_USER_ID=1
