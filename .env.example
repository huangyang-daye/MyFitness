# PostgreSQL
# Windows 建议用 127.0.0.1 而非 localhost（避免 IPv6 连接等待 2min+）
# RAG 使用本实例上的 pgvector 扩展，不要再启动第二个占用 5432 的 pgvector 容器。
DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/myfitness
# DB_CONNECT_TIMEOUT=5


# LLM — OpenAI 兼容通用接口（DeepSeek、OpenAI、Ollama 代理等）
# 填写 BASE_URL + API_KEY + MODEL 即可激活
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# LLM 限制与兜底：重试/退避为内置常量；以下守卫参数可按需调整
# 守卫内置默认：最小间隔 1s，连续失败 3 次熔断 60s（详见 src/myfitness/llm/guard.py）

# 兼容旧变量（LLM_API_KEY 优先）
# OPENAI_API_KEY=

# 使用记录目录 — 与项目本体分离
# 报告、图表、对话历史等运行时产物一律写在 DATA_DIR 之下，不污染项目目录。
# 留空则回落到平台默认：Windows %LOCALAPPDATA%\MyFitness，
# macOS ~/Library/Application Support/MyFitness，Linux ~/.local/share/MyFitness。
DATA_DIR=D:/MyFitness-data

# 调度（M3+ 使用）
DAILY_REPORT_TIME=07:00
DAILY_REPORT_MODE=full
# 以下三项留空即分别回落到 <DATA_DIR>/reports、<DATA_DIR>/reports/charts、
# <DATA_DIR>/chat-history；需要分盘存放时再单独覆盖。
# DAILY_REPORT_OUTPUT_DIR=
# 统计图（mermaid）独立文档输出目录
# CHART_OUTPUT_DIR=
# Agent 生成文档输出目录（md / docx / pdf）
# DOCUMENT_OUTPUT_DIR=
# 对话记录目录
# CHAT_HISTORY_DIR=

# 记忆系统（Redis 工作记忆 + PostgreSQL 情景摘要/用户画像）
# MEMORY_ENABLED=true
# MEMORY_SHORT_TERM_TURNS=8
# MEMORY_COMPRESS_CHARS=1200
# MEMORY_PROFILE_MAX_ITEMS=8
# Redis 未配置或不可用时，工作记忆自动回退到进程内存储。
# REDIS_URL=redis://127.0.0.1:6379/0
# MEMORY_WORKING_TTL_SECONDS=604800
# MEMORY_REDIS_TIMEOUT=2
# MEMORY_EPISODIC_LIMIT=8
# MEMORY_VECTOR_POOL_SIZE=2
# LangGraph 分析子图 checkpointer TTL（秒）；默认与工作记忆一致。配置 REDIS_URL 后自动启用 Redis 断点持久化。
# CHECKPOINT_TTL_SECONDS=604800

# 联网检索（对话中检索中国互联网公开资料）
# 推荐配置博查 Bocha（https://open.bochaai.com ）或智谱 GLM Web Search。
# WEB_SEARCH_PROVIDER=auto 时：有 BOCHA_API_KEY 用博查，否则有 ZHIPU_API_KEY 用智谱，
# 都没有则回退 DuckDuckGo / 必应中国版（无需密钥，中文结果质量较弱）。
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_PROVIDER=auto
# WEB_SEARCH_API_KEY=
# BOCHA_API_KEY=
# ZHIPU_API_KEY=
# WEB_SEARCH_COUNT=8
# WEB_SEARCH_TIMEOUT=15
# WEB_SEARCH_FRESHNESS=noLimit
# 中文平台搜索（小红书 / 知乎 / B 站 / 微博 / 淘宝 / 京东 / 豆瓣 / 大众点评 / 抖音）
# 需先安装：pip install cn-scraper-mcp   或   pip install -e ".[cn-search]"
# 登录态 Cookie 保存在本机 ~/.cn-scraper-cookies/，也可用 guided_login 初始化。
# 也可改走远程 MCP：docker 启动 cn-scraper-mcp 后填写 URL。
# CN_SCRAPER_ENABLED=true
# CN_SCRAPER_MCP_URL=
# CN_SCRAPER_PLATFORMS=auto
# CN_SCRAPER_DEFAULT_PLATFORMS=bilibili
# CN_SCRAPER_TIMEOUT=25

# EMBEDDING_DIMENSIONS 须与模型输出维度一致，且与 pgvector 列 vector(N) 对齐。
# 修改后请运行：myfitness rag init && myfitness rag index --full
# DeepSeek、Claude 等聊天模型没有 embedding 接口，不能复用 LLM_BASE_URL。
# 未单独配置时语义检索会跳过，对话仍可进行。
# OpenAI 示例：
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# 国内可用硅基流动等兼容接口，例如：
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIMENSIONS 须与模型输出维度一致，且与 pgvector 列类型匹配。
# 修改后请运行：myfitness rag init && myfitness rag index --full
RAG_ENABLED=true
RAG_TOP_K=5
# 每路召回条数（向量 KNN / BM25），融合后再精排到 RAG_TOP_K
RAG_RECALL_K=20
# Reciprocal Rank Fusion 常数，越大越平滑
RAG_RRF_K=60
# 精排后 minScore（BM25 归一化到 0~1；BM25 全 0 时回退向量余弦）
RAG_MIN_SIMILARITY=0.35

# PDF 解析（知识库上传 / read_document）
# 默认 MinerU：布局还原与扫描件 OCR 优于 pypdf。
# 安装：pip install -e ".[mineru]"   或单独启动 mineru-api 后填写 URL。
# PDF_PARSER=mineru
# MINERU_API_URL=http://127.0.0.1:8000
# MINERU_API_TOKEN=
# MINERU_BACKEND=pipeline
# MINERU_PARSE_METHOD=auto
# MINERU_LANG=ch
# MINERU_FORMULA_ENABLE=true
# MINERU_TABLE_ENABLE=true
# MINERU_TIMEOUT=600
# MinerU 不可用时是否回退 pypdf（false 则直接报错）
# MINERU_FALLBACK_PYPDF=true

# 应用
LOG_LEVEL=INFO
DEBUG_MODE=false
# 在控制台打印 ORM / 原生 SQL（DEBUG_MODE=true 时也会自动开启）
# SQL_ECHO=false
DEFAULT_USER_ID=1
